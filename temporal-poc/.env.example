# Temporal Server Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Task Queue
TASK_QUEUE=supplier-lifecycle

# PostgreSQL Configuration (if running Temporal locally)
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_DB=temporal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info

# Workflow Configuration
WORKFLOW_TASK_TIMEOUT=10s
ACTIVITY_START_TO_CLOSE_TIMEOUT=5m
ACTIVITY_SCHEDULE_TO_CLOSE_TIMEOUT=10m

# Optional: Temporal Cloud Configuration
# TEMPORAL_CLOUD_NAMESPACE=your-namespace.account-id
# TEMPORAL_CLOUD_ADDRESS=your-namespace.account-id.tmprl.cloud:7233
# TEMPORAL_CLIENT_CERT_PATH=./certs/client.pem
# TEMPORAL_CLIENT_KEY_PATH=./certs/client.key
