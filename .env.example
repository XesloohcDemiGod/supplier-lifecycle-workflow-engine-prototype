# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DB_PATH=./data/suppliers.sqlite
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session Security
SESSION_TIMEOUT=30m
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PER_USER_WINDOW_MS=300000
RATE_LIMIT_PER_USER_MAX_REQUESTS=50

# Request Size Limits
MAX_REQUEST_SIZE=5mb
MAX_FILE_SIZE=50mb
MAX_ARRAY_SIZE=100
MAX_STRING_LENGTH=1000

# Security
BCRYPT_ROUNDS=10
TLS_MIN_VERSION=TLSv1.2

# Fraud Detection
MAX_ACCOUNT_CREATIONS_PER_HOUR=5
MAX_REQUESTS_PER_MINUTE_PER_USER=10

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# DDoS Protection
REQUEST_TIMEOUT_MS=30000
MAX_CONNECTIONS_PER_IP=10

# Redis Configuration (Optional - for distributed rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false
